# ─────────────────────────────────────────────────────────────────────────────
# VILP — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# Source: TRD §50
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-secure-random-256-bit-base64-encoded-key

# ── Google OAuth (optional for MVP dev, required for production) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (used in docker-compose; override for external DB) ───────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/vilpdb
DATABASE_USERNAME=vilpuser
DATABASE_PASSWORD=vilppassword

# ── Email (Mailhog for dev — no real credentials needed) ─────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Object Storage (Phase 2+) ─────────────────────────────────────────────────
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=

# ── AI Service (Phase 5+) ─────────────────────────────────────────────────────
AI_API_KEY=
AI_API_URL=

# ── n8n Automation (Phase 7+) ─────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=
