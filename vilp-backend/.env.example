# ─────────────────────────────────────────────────────────────────────────────
# VILP Backend Environment Variables (for Render / Local)
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://<host>:5432/<database_name>
DATABASE_USERNAME=<db_user>
DATABASE_PASSWORD=<db_password>

# JWT Security
JWT_SECRET=vilp-super-secret-key-256-bit-long-string-for-security-production
JWT_ACCESS_EXPIRY_MS=1800000
JWT_REFRESH_EXPIRY_MS=604800000

# AI Models (Groq / Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Client URLs & CORS
FRONTEND_URL=https://internship-lifecycle-management-pla.vercel.app
CORS_ORIGINS=https://internship-lifecycle-management-pla.vercel.app,http://localhost:5173

# Mail (Optional for SMTP email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
